#!/usr/bin/env bash
set -euo pipefail

clear
echo "╔═══════════════════════════════════════════════════════╗"
echo "║                    CREATE SSH ACCOUNT                 ║"
echo "╚═══════════════════════════════════════════════════════╝"

read -rp "Username : " USERNAME
read -rp "Password : " PASSWORD
read -rp "Expired (days) : " DAYS
read -rp "Limit IP (0=unlimited): " LIMIT_IP
LIMIT_IP="${LIMIT_IP:-0}"
read -rp "Limit Quota GB (0=unlimited): " LIMIT_QUOTA
LIMIT_QUOTA="${LIMIT_QUOTA:-0}"

echo
/usr/local/sbin/create-ssh-bot "$USERNAME" "$PASSWORD" "$DAYS" "$LIMIT_IP" "$LIMIT_QUOTA"

echo
read -n 1 -s -r -p "Press any key to continue..."
echo
